// Cloudflare Worker for SurTaal: serves the app (built into dist/ by
// scripts/build.mjs) and answers /api/… (see worker/index.js).
// Deployed by .github/workflows/pages.yml once the Cloudflare secrets are set.
{
  "name": "surtaal",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Each learner (or, without accounts, each address) may ask the AI teacher
  // at most 10 questions a minute.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // Any Gemini model name from Google AI Studio. A fixed model, not
    // "gemini-flash-latest": the moving alias made every answer time out.
    "GEMINI_MODEL": "gemini-3.8-flash",
    // How hard Gemini thinks before answering: minimal, low, medium or high
    // ("" lets the model decide). Lower is faster.
    "GEMINI_THINKING": "low",
    // Other places the app runs that may use the API.
    "ALLOWED_ORIGINS": "https://surtaal.app,https://surtaal.surtaal-app.workers.dev,capacitor://localhost,https://sukantasahabim-cyber.github.io"
  },
  // The app's own address. The workers.dev address keeps working too.
  "routes": [{ "pattern": "surtaal.app", "custom_domain": true }],
  "observability": { "enabled": true }
}
