// Cloudflare Worker for SurTaal: serves the app (built into dist/ by
// scripts/build.mjs) and answers /api/… (see worker/index.js).
// Deployed by .github/workflows/pages.yml once the Cloudflare secrets are set.
{
  "name": "surtaal",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Each learner (or, without accounts, each address) may ask the AI teacher
  // at most 10 questions a minute.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // Any Gemini model name from Google AI Studio; this one always follows
    // Google's latest Flash model.
    "GEMINI_MODEL": "gemini-flash-latest",
    // Other places the app runs that may use the API.
    "ALLOWED_ORIGINS": "capacitor://localhost,https://sukantasahabim-cyber.github.io"
  },
  "observability": { "enabled": true }
  // After buying a domain on Cloudflare, add it here, for example:
  // "routes": [{ "pattern": "surtaal.app", "custom_domain": true }]
}
